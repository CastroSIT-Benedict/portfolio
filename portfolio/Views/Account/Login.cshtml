
@model portfolio.Models.LoginViewModel

@{
    ViewData["Title"] = "Editor Login";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/login.css"
          asp-append-version="true" />
}

<div class="login-page">

    <!-- BACKGROUND DETAILS -->
    <div class="login-background-grid"></div>
    <div class="login-background-glow"></div>

    <!-- LOGIN PANEL -->
    <div class="login-panel">

        <div class="login-panel-top">
            <span class="login-eyebrow">PORTFOLIO / RESTRICTED ACCESS</span>
            <span class="login-status">
                <span class="status-dot"></span>
                SECURE AREA
            </span>
        </div>

        <!-- ICON -->
        <div class="login-icon">
            <span>01</span>
            <div class="login-icon-line"></div>
        </div>

        <!-- HEADING -->
        <div class="login-heading">
            <span class="login-subtitle">WELCOME BACK</span>

            <h1>Editor <span>Access.</span></h1>

            <p>
                Sign in to access your portfolio dashboard
                and manage your projects.
            </p>
        </div>

        <!-- LOGIN FORM -->
        <form asp-controller="Account"
              asp-action="Login"
              asp-route-returnUrl="@returnUrl"
              method="post"
              class="login-form">

            @Html.AntiForgeryToken()

            @if (ViewBag.TooManyAttempts == true)
                {
                    <div class="login-rate-limit-warning" role="alert">
                        <strong>Too many login attempts.</strong>
                        <span>Please wait one minute before trying again.</span>
                    </div>
                }

                <div asp-validation-summary="ModelOnly"
                     class="login-validation-summary">
                </div>

            <!-- USERNAME -->
            <div class="login-field">
                <label asp-for="Username">USERNAME</label>

                <input asp-for="Username"
                       class="form-control"
                       placeholder="Enter your username"
                       autocomplete="username"
                       autofocus />

                <span asp-validation-for="Username"
                      class="login-validation">
                </span>
            </div>

            <!-- PASSWORD -->
            <div class="login-field">
                <label asp-for="Password">PASSWORD</label>

                <input asp-for="Password"
                       class="form-control"
                       placeholder="Enter your password"
                       autocomplete="current-password" />

                <span asp-validation-for="Password"
                      class="login-validation">
                </span>
            </div>

            <!-- SUBMIT -->
            <button type="submit" class="login-submit">
                <span>Access Portfolio</span>
                <span class="login-submit-arrow">→</span>
            </button>

        </form>

        <div class="login-panel-footer">
            <span>AUTHORIZED EDITORS ONLY</span>
            <span>PORTFOLIO SYSTEM / 01</span>
        </div>

    </div>

    <!-- PAGE FOOTER -->
    <div class="login-page-caption">
        <span>DESIGNED TO CREATE.</span>
        <span>BUILT TO DEVELOP.</span>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
