@{
    ViewData["Title"] = "Home";
}

<section class="hero-section" id="top">



    <!-- BACKGROUND DECORATIONS -->
    <div class="hero-grid"></div>
    <div class="hero-glow"></div>
    <div class="hero-orbit"></div>

    <div class="hero-content">

        <!-- LEFT: INTRODUCTION -->
        <div class="hero-text">

            <div class="hero-eyebrow">
                <span class="hero-status-dot"></span>
                AVAILABLE FOR OPPORTUNITIES
            </div>

            <p class="hero-greeting">
                WELCOME, I'M
            </p>

            <h1 class="hero-name">
                BENEDICT<br />
                <span>CASTRO.</span>
            </h1>

            <div class="hero-role">
                <span class="role-prefix">I'M A</span>
                <span id="rotating-role" class="role-highlight">
                    DEVELOPER
                </span>
                <span class="role-cursor"></span>
            </div>

            <p class="hero-description">
                I strive to be a Man who is always learning and building. 
                I am passionate about technology and programming, 
                and I enjoy creating innovative solutions to real-world problems. 
            </p>

            <div class="hero-buttons">

                <a asp-controller="Projects"
                   asp-action="Index"
                   class="hero-button hero-button-primary">
                    View My Projects
                    <span class="button-arrow">↗</span>
                </a>

                <a href="#contact"
                   class="hero-button hero-button-secondary">
                    Contact Me
                </a>

            </div>

            <div class="hero-social">
                <span class="social-label">FIND ME ON</span>

                <a href="https://github.com/CastroSIT-Benedict"
                   target="_blank"
                   rel="noopener noreferrer">
                    GITHUB ↗
                </a>

                <a href="https://www.linkedin.com/in/benedict-james-castro-666890396/"
                   target="_blank"
                   rel="noopener noreferrer">
                    LINKEDIN ↗
                </a>
            </div>

        </div>

        <!-- RIGHT: PORTRAIT -->
        <div class="hero-portrait">

            <div class="portrait-background"></div>

            <div class="portrait-image">
                <img src="~/images/portrait.png"
                     alt="Portrait of BENEDICT CASTRO"
                     asp-append-version="true" />
            </div>

            <!-- DECORATIVE LABELS -->
            <div class="portrait-label portrait-label-top">
                <span class="label-line"></span>
                PORTFOLIO / 2026
            </div>

            <div class="portrait-label portrait-label-bottom">
                <span class="portrait-number">01</span>
                <span>NETWORKING AND CYBERSECURITY.</span>
            </div>

            <div class="portrait-corner portrait-corner-top"></div>
            <div class="portrait-corner portrait-corner-bottom"></div>

        </div>

    </div>

    <!-- SCROLL INDICATOR -->
    <a href="#about" class="hero-scroll">
        <span class="scroll-line"></span>
        SCROLL TO EXPLORE
        <span class="scroll-arrow">↓</span>
    </a>

    <div class="hero-index">01 / 05</div>


</section>


<!-- ========================================
     ABOUT ME
======================================== -->

<section class="about-section" id="about">

    <div class="about-container">

        <!-- SECTION HEADING -->
        <div class="section-heading">
            <span class="section-label">01 / GET TO KNOW ME</span>
            <h2>A LITTLE <span>ABOUT ME.</span></h2>
            <p>A quick introduction to the person behind the code.</p>
        </div>

        <div class="about-content">

            <!-- LEFT: INTRODUCTION -->
            <div class="about-intro">

                <span class="about-greeting">WHO AM I?</span>

                <h3>
                    More than just
                    <span>lines of code.</span>
                </h3>

                <p>
                    Technology fascinated me through the power of video games, and I was drawn to the world of programming.
                </p>

                <p>
                    I am naturally curious about how technology works, and  strive to understand the underlying principles and mechanisms that drive it.
                    When something works, I want to know why it works, and when something doesn't work, I want to know how to fix it.
                </p>

                <div class="about-signature">
                    <span class="signature-line"></span>
                    <span>ALWAYS LEARNING. ALWAYS BUILDING.</span>
                </div>

            </div>

            <!-- RIGHT: PROFILE DASHBOARD -->
            <div class="about-dashboard">

                <div class="about-card">
                    <div class="about-card-icon">⌘</div>
                    <span class="about-card-label">CURRENT FOCUS</span>
                    <h4>Bachelor of Science in Information Technology</h4>
                    <p>Networking and Cybersecurity</p>
                    <span class="about-card-number">01</span>
                </div>

                <div class="about-card">
                    <div class="about-card-icon">⌖</div>
                    <span class="about-card-label">LOCATION</span>
                    <h4>Philippines</h4>
                    <p>Benguet, Baguio City</p>
                    <span class="about-card-number">02</span>
                </div>

                <div class="about-card">
                    <div class="about-card-icon">✳</div>
                    <span class="about-card-label">INTERESTS</span>
                    <h4>Technology</h4>
                    <p>Gaming, Web Development, Networking</p>
                    <span class="about-card-number">03</span>
                </div>

                <div class="about-card">
                    <div class="about-card-icon">⌁</div>
                    <span class="about-card-label">MY APPROACH</span>
                    <h4>It works, but why?</h4>
                    <p>naturally curious, always seeking to understand the "why" behind the "how."</p>
                    <span class="about-card-number">04</span>
                </div>

            </div>

        </div>

        <!-- BOTTOM DECORATIVE LINE -->
        <div class="about-bottom-line">
            <span>END OF INTRODUCTION</span>
            <span>02 — 05</span>
        </div>

    </div>

</section>


