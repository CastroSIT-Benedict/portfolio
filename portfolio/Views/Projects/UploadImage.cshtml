
@model portfolio.Models.ProjectImageUpload

@{
    ViewData["Title"] = "Upload Project Image";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/project-forms.css"
          asp-append-version="true" />
}

<div class="editor-page">
    <section class="editor-panel upload-panel">

        <header class="editor-heading">
            <div>
                <span class="editor-eyebrow">EDITOR / PROJECT GALLERY</span>
                <h1>Upload Image</h1>
                <p>Add a new visual to <strong>@ViewBag.ProjectTitle</strong>.</p>
            </div>

            <span class="editor-panel-mark">MEDIA UPLOAD</span>
        </header>

        <form asp-controller="Projects"
              asp-action="UploadImage"
              method="post"
              enctype="multipart/form-data"
              class="editor-form upload-form">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="ProjectId" />

            <div asp-validation-summary="ModelOnly"
                 class="editor-validation-summary">
            </div>

            
<!-- IMAGE SELECTION -->
<div class="editor-field upload-file-field">
    <label asp-for="ImageFile">Select Image</label>

    <label for="ImageFile" class="upload-dropzone">
        <div class="upload-dropzone-content">
            <span class="upload-icon">＋</span>
            <strong>Choose an image</strong>
            <span>JPG, PNG, or WebP · Maximum 5 MB</span>
            <span class="upload-browse-text">Browse files</span>
        </div>

        <input asp-for="ImageFile"
               type="file"
               accept=".jpg,.jpeg,.png,.webp"
               id="ImageFile"
               class="upload-file-input" />
    </label>

    <span asp-validation-for="ImageFile"
          class="editor-validation">
    </span>
</div>


            <!-- IMAGE PREVIEW -->
            <div class="editor-field upload-preview-field">
                <label>Image Preview</label>

                <div id="previewContainer"
                     class="upload-preview"
                     hidden>

                    <div class="upload-preview-image">
                        <img id="imagePreview"
                             src=""
                             alt="Selected image preview" />
                    </div>

                    <div class="upload-preview-info">
                        <span class="upload-preview-status">
                            SELECTED IMAGE
                        </span>

                        <p id="fileName"></p>
                    </div>
                </div>

                <div id="previewPlaceholder"
                     class="upload-preview-placeholder">
                    <span class="upload-placeholder-icon">▧</span>
                    <p>Your image preview will appear here.</p>
                </div>
            </div>

            <!-- CAPTION -->
            <div class="editor-field">
                <label asp-for="Caption">Caption <span>(Optional)</span></label>

                <input asp-for="Caption"
                       class="form-control"
                       placeholder="Describe this image..." />

                <span asp-validation-for="Caption"
                      class="editor-validation">
                </span>
            </div>

            <!-- DISPLAY ORDER -->
            <div class="editor-field">
                <label asp-for="DisplayOrder">Display Order</label>

                <input asp-for="DisplayOrder"
                       type="number"
                       min="1"
                       class="form-control" />

                <span asp-validation-for="DisplayOrder"
                      class="editor-validation">
                </span>
            </div>

            <!-- ACTIONS -->
            <div class="editor-form-actions">
                <a asp-controller="Projects"
                   asp-action="Index"
                   class="editor-cancel-button">
                    Cancel
                </a>

                <button type="submit"
                        class="editor-save-button">
                    Upload Image
                </button>
            </div>

        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const imageInput = document.getElementById("ImageFile");
        const previewContainer = document.getElementById("previewContainer");
        const previewPlaceholder = document.getElementById("previewPlaceholder");
        const imagePreview = document.getElementById("imagePreview");
        const fileName = document.getElementById("fileName");

        let currentImageUrl = null;

        imageInput.addEventListener("change", function () {
            const file = this.files[0];

            if (currentImageUrl) {
                URL.revokeObjectURL(currentImageUrl);
                currentImageUrl = null;
            }

            if (!file) {
                previewContainer.hidden = true;
                previewPlaceholder.hidden = false;
                imagePreview.src = "";
                fileName.textContent = "";
                return;
            }

            currentImageUrl = URL.createObjectURL(file);

            imagePreview.src = currentImageUrl;
            fileName.textContent = file.name;

            previewContainer.hidden = false;
            previewPlaceholder.hidden = true;
        });

        window.addEventListener("beforeunload", function () {
            if (currentImageUrl) {
                URL.revokeObjectURL(currentImageUrl);
            }
        });
    </script>
}
