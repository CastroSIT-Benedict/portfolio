
@model portfolio.Models.ProjectImageUpload

@{
    ViewData["Title"] = "Upload Project Image";
}

<section class="mb-4">
    <h1>Upload Project Image</h1>
    <p class="text-muted">
        Add an image to <strong>@ViewBag.ProjectTitle</strong>.
    </p>
</section>

<form asp-controller="Projects"
      asp-action="UploadImage"
      method="post"
      enctype="multipart/form-data">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <input type="hidden" asp-for="ProjectId" />

    <div class="mb-3">
        <label asp-for="ImageFile" class="form-label">
            Select Image
        </label>

        <input asp-for="ImageFile"
               type="file"
               class="form-control"
               accept=".jpg,.jpeg,.png,.webp"
               id="ImageFile" />

        <span asp-validation-for="ImageFile"
              class="text-danger"></span>

        <small class="text-muted">
            Accepted formats: JPG, PNG, and WebP. Maximum size: 5 MB.
        </small>
    </div>

    <!-- Image Preview -->
    <div class="mb-3" id="previewContainer" style="display: none;">
        <label class="form-label">Image Preview</label>

        <div class="card" style="max-width: 500px;">
            <img id="imagePreview"
                 src=""
                 alt="Selected image preview"
                 class="card-img-top"
                 style="max-height: 300px; object-fit: contain; background: #f5f5f5;" />

            <div class="card-body">
                <p class="card-text mb-0" id="fileName"></p>
            </div>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Caption" class="form-label">
            Caption (Optional)
        </label>

        <input asp-for="Caption"
               class="form-control"
               placeholder="Describe this image..." />

        <span asp-validation-for="Caption"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DisplayOrder" class="form-label">
            Display Order
        </label>

        <input asp-for="DisplayOrder"
               type="number"
               min="1"
               class="form-control" />

        <span asp-validation-for="DisplayOrder"
              class="text-danger"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            Upload Image
        </button>

        <a asp-controller="Projects"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Cancel
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const imageInput = document.getElementById("ImageFile");
        const previewContainer = document.getElementById("previewContainer");
        const imagePreview = document.getElementById("imagePreview");
        const fileName = document.getElementById("fileName");

        let currentImageUrl = null;

        imageInput.addEventListener("change", function () {
            const file = this.files[0];

            if (currentImageUrl) {
                URL.revokeObjectURL(currentImageUrl);
                currentImageUrl = null;
            }

            if (!file) {
                previewContainer.style.display = "none";
                imagePreview.src = "";
                fileName.textContent = "";
                return;
            }

            currentImageUrl = URL.createObjectURL(file);

            imagePreview.src = currentImageUrl;
            fileName.textContent = file.name;

            previewContainer.style.display = "block";
        });
    </script>
}
