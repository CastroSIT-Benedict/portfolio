
@model portfolio.Models.Course

@{
    ViewData["Title"] = "Edit Course";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/project-forms.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/courses.css"
          asp-append-version="true" />
}

<div class="editor-page course-editor-page">

    <!-- PAGE HEADING -->
    <div class="editor-heading">
        <span class="editor-eyebrow">PORTFOLIO / COURSES</span>

        <h1>Edit <span>Course</span></h1>

        <p>Update the details of this course.</p>
    </div>

    <!-- COURSE FORM PANEL -->
    <div class="editor-panel">

        <div class="editor-panel-header">
            <div>
                <span class="editor-panel-label">EDIT ENTRY</span>
                <h2>Course Information</h2>
            </div>

            <span class="editor-panel-mark">02</span>
        </div>

        <form asp-controller="Courses"
              asp-action="Edit"
              asp-route-id="@Model.CourseId"
              method="post"
              class="editor-form course-editor-form">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="CourseId" />

            <div asp-validation-summary="ModelOnly"
                 class="editor-validation-summary">
            </div>

            <!-- COURSE CODE -->
            <div class="editor-field">
                <label asp-for="CourseCode">Course Code</label>

                <input asp-for="CourseCode"
                       class="form-control"
                       placeholder="e.g. DBMWEB1" />

                <span asp-validation-for="CourseCode"
                      class="editor-validation">
                </span>
            </div>

            <!-- COURSE NAME -->
            <div class="editor-field course-name-field">
                <label asp-for="CourseName">Course Name</label>

                <input asp-for="CourseName"
                       class="form-control"
                       placeholder="Enter the full course name" />

                <span asp-validation-for="CourseName"
                      class="editor-validation">
                </span>
            </div>

            <!-- FORM ACTIONS -->
            <div class="editor-form-actions">

                <button type="submit" class="editor-save-button">
                    Save Changes <span>→</span>
                </button>

                <a asp-controller="Courses"
                   asp-action="Index"
                   class="editor-cancel-button">
                    Cancel
                </a>

            </div>

        </form>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
