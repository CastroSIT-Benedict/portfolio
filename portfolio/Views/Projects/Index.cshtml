
@model List<portfolio.Models.Project>

@{
    ViewData["Title"] = "Projects";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/projects.css"
          asp-append-version="true" />
}

<div class="projects-page">

    <!-- PAGE HEADER -->
    <section class="projects-hero">
        <div class="projects-hero-content">

            <span class="projects-eyebrow">
                PORTFOLIO / PROJECT ARCHIVE
            </span>

            <h1>
                My <span>Projects</span>
            </h1>

            <p>
                A collection of projects I've built throughout my academic journey.
                Each one represents something I've learned, explored, and created.
            </p>

            <div class="projects-hero-line"></div>

        </div>

        <div class="projects-hero-decoration">
            <span class="decoration-square"></span>
            <span class="decoration-square"></span>
            <span class="decoration-square"></span>
        </div>
    </section>

    <!-- NOTIFICATIONS -->
    @if (TempData["Success"] != null)
    {
        <div class="project-alert project-alert-success auto-dismiss">
            <span class="alert-indicator"></span>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="project-alert project-alert-error">
            <span class="alert-indicator"></span>
            @TempData["Error"]
        </div>
    }

    <!-- EDITOR CONTROLS -->
    @if (User.IsInRole("Editor"))
    {
        <div class="project-admin-toolbar">

            <div>
                <span class="admin-label">ADMIN CONTROLS</span>
                <p>Manage your portfolio collection.</p>
            </div>

            <div class="admin-actions">

                <a asp-controller="Courses"
                   asp-action="Index"
                   class="project-admin-button secondary">
                    Manage Courses
                </a>

                <a asp-controller="Projects"
                   asp-action="Create"
                   class="project-admin-button primary">
                    <span>+</span> Add Project
                </a>

            </div>
        </div>
    }

    <!-- PROJECT CONTENT -->

    <!-- PROJECT SEARCH -->
    @if (Model.Count > 0)
    {
        <div class="project-search">
            <div class="project-search-heading">
                <span class="admin-label">PROJECT ARCHIVE</span>
                <p>Find a project from your collection.</p>
            </div>

            <div class="project-search-box">
                <span class="project-search-icon">⌕</span>

                <input type="search"
                       id="projectSearch"
                       placeholder="Search projects, descriptions, or courses..."
                       aria-label="Search projects" />

                <button type="button"
                        id="clearProjectSearch"
                        aria-label="Clear search">
                    ×
                </button>
            </div>

            <p class="project-search-status" id="projectSearchStatus" aria-live="polite"></p>
        </div>
    }


    @if (Model.Count == 0)
    {
        <div class="projects-empty">
            <span class="empty-symbol">[ 00 ]</span>
            <h2>No Projects Yet</h2>
            <p>There are currently no projects in the collection.</p>
        </div>
    }
    else
    {
        <div class="projects-collection">

            @foreach (var course in Model.GroupBy(p => new { p.CourseCode, p.CourseName }))
            {
                <section class="course-section"
                         data-course-search="@course.Key.CourseCode @course.Key.CourseName">

                    <!-- COURSE HEADER -->
                    <button type="button"
                            class="course-header course-toggle"
                            aria-expanded="false"
                            aria-controls="course-projects-@course.Key.CourseCode">

                        <div class="course-heading">
                            <span class="course-label">COURSE / CATEGORY</span>

                            <h2>@course.Key.CourseCode</h2>

                            <p>@course.Key.CourseName</p>
                        </div>

                        <div class="course-header-actions">
                            <div class="course-count">
                                <span>@course.Count().ToString("00")</span>
                                <small>PROJECT@(course.Count() == 1 ? "" : "S")</small>
                            </div>

                            <span class="course-toggle-icon" aria-hidden="true">+</span>
                        </div>

                    </button>

                    <!-- PROJECT GRID -->
                    <div class="course-projects"
                         id="course-projects-@course.Key.CourseCode"
                         hidden>

                        <div class="projects-grid">

                        @foreach (var project in course)
                        {
                            <!-- PROJECT PREVIEW CARD -->
                                <article class="project-card"
                                         data-project-search="@project.Title @project.Description">

                                <div class="project-card-top">
                                    <span class="project-number">
                                        PROJECT / @project.ProjectId.ToString("00")
                                    </span>

                                    <span class="project-status-dot"></span>
                                </div>

                                <div class="project-card-content">

                                    <h3>@project.Title</h3>

                                    <p class="project-description">
                                        @(project.Description ?? "No description available.")
                                    </p>

                                    <div class="project-date">
                                        <span class="date-icon">◷</span>
                                        @(project.ProjectDate?.ToString("MMMM dd, yyyy") ?? "No date")
                                    </div>

                                    <button type="button"
                                            class="project-expand-button"
                                            data-project-open="project-overlay-@project.ProjectId">

                                        <span>View Full Project</span>
                                        <span class="expand-icon">↗</span>

                                    </button>

                                </div>

                                <div class="project-card-bottom">
                                    <span>PORTFOLIO ENTRY</span>
                                    <span>///</span>
                                </div>


                            </article>

                            <!-- FULL PROJECT OVERLAY -->
                            <div class="project-overlay"
                                 id="project-overlay-@project.ProjectId"
                                 aria-hidden="true">

                                <div class="project-overlay-panel"
                                     role="dialog"
                                     aria-modal="true"
                                     aria-labelledby="project-title-@project.ProjectId">

                                    <!-- OVERLAY HEADER -->
                                    <div class="project-overlay-header">

                                        <span class="project-overlay-label">
                                            PROJECT / @project.ProjectId.ToString("00")
                                        </span>

                                        <button type="button"
                                                class="project-overlay-close"
                                                aria-label="Close project">
                                            ×
                                        </button>

                                    </div>

                                    <!-- PROJECT INFORMATION -->
                                    <div class="project-overlay-body">

                                        <div class="project-overlay-intro">

                                            <span class="details-label">PROJECT OVERVIEW</span>

                                            <h2 id="project-title-@project.ProjectId">
                                                @project.Title
                                            </h2>

                                            <p class="project-overlay-description">
                                                @(project.Description ?? "No description available.")
                                            </p>

                                            <div class="project-overlay-date">
                                                <span>PROJECT DATE</span>

                                                <strong>
                                                    @(project.ProjectDate?.ToString("MMMM dd, yyyy") ?? "No date")
                                                </strong>
                                            </div>

                                            <!-- PROJECT LINKS -->
                                            @if (!string.IsNullOrEmpty(project.GithubUrl)
                                                || !string.IsNullOrEmpty(project.VideoUrl))
                                            {
                                                <div class="project-overlay-links">

                                                    @if (!string.IsNullOrEmpty(project.GithubUrl))
                                                    {
                                                        <a href="@project.GithubUrl"
                                                           target="_blank"
                                                           rel="noopener noreferrer">
                                                            View GitHub Repository ↗
                                                        </a>
                                                    }

                                                    @if (!string.IsNullOrEmpty(project.VideoUrl))
                                                    {
                                                        <a href="@project.VideoUrl"
                                                           target="_blank"
                                                           rel="noopener noreferrer">
                                                            Watch Video Demo ↗
                                                        </a>
                                                    }

                                                </div>
                                            }

                                        </div>

                                        <!-- PROJECT IMAGES -->
                                        @if (project.Images.Count > 0)
                                        {
                                            <section class="project-overlay-gallery">

                                                <div class="overlay-section-heading">
                                                    <span class="details-label">PROJECT GALLERY</span>
                                                    <span>@project.Images.Count IMAGE(S)</span>
                                                </div>

                                                <div class="overlay-image-grid">

                                                    @foreach (var image in project.Images)
                                                    {
                                                        <div class="overlay-image-item">

                                                            <img src="@image.ImageUrl"
                                                                 alt="@(image.Caption ?? project.Title)"
                                                                 class="project-thumbnail"
                                                                 loading="lazy"
                                                                 data-full-image="@image.ImageUrl"
                                                                 data-image-caption="@image.Caption" />

                                                            @if (!string.IsNullOrWhiteSpace(image.Caption))
                                                            {
                                                                <p>@image.Caption</p>
                                                            }

                                                            @if (User.IsInRole("Editor"))
                                                            {
                                                                <form asp-controller="Projects"
                                                                      asp-action="DeleteImage"
                                                                      method="post"
                                                                      onsubmit="return confirm('Are you sure you want to delete this image?');">

                                                                    @Html.AntiForgeryToken()

                                                                    <input type="hidden"
                                                                           name="imageId"
                                                                           value="@image.ImageId" />

                                                                    <button type="submit"
                                                                            class="delete-image-button">
                                                                        Delete Image
                                                                    </button>

                                                                </form>
                                                            }

                                                        </div>
                                                    }

                                                </div>

                                            </section>
                                        }

                                        <!-- EDITOR CONTROLS -->
                                        @if (User.IsInRole("Editor"))
                                        {
                                            <div class="project-overlay-admin">

                                                <span class="details-label">PROJECT MANAGEMENT</span>

                                                <div class="project-editor-actions">

                                                    <a asp-controller="Projects"
                                                       asp-action="Edit"
                                                       asp-route-id="@project.ProjectId"
                                                       class="editor-action edit-action">
                                                        Edit Project
                                                    </a>

                                                    <a asp-controller="Projects"
                                                       asp-action="UploadImage"
                                                       asp-route-projectId="@project.ProjectId"
                                                       class="editor-action upload-action">
                                                        Upload Image
                                                    </a>

                                                    <!-- DELETE PROJECT FORM -->
                                                    <form asp-controller="Projects"
                                                          asp-action="Delete"
                                                          asp-route-id="@project.ProjectId"
                                                          method="post"
                                                          class="project-delete-form">

                                                        @Html.AntiForgeryToken()

                                                        <button type="submit"
                                                                class="editor-action delete-action"
                                                                data-confirm-delete
                                                                data-confirm-title="Delete Project?"
                                                                data-confirm-message="Are you sure you want to delete this project? This action cannot be undone."
                                                                data-confirm-button="Delete Project">
                                                            Delete Project
                                                        </button>

                                                    </form>

                                                </div>

                                            </div>
                                        }

                                    </div>

                                    <!-- OVERLAY FOOTER -->
                                    <div class="project-overlay-footer">
                                        <span>PORTFOLIO / PROJECT ARCHIVE</span>
                                        <span>PROJECT / @project.ProjectId.ToString("00")</span>
                                    </div>

                                </div>
                            </div>
                        }

                        </div>
                    </div>

                </section>
            }

        </div>
    }

</div>

<!-- IMAGE LIGHTBOX -->
<div id="imageLightbox" class="image-lightbox">

    <button type="button"
            id="lightboxClose"
            class="lightbox-close"
            aria-label="Close image">
        ×
    </button>

    <div class="lightbox-content">

        <img id="lightboxImage"
             src=""
             alt="Expanded project image" />

        <p id="lightboxCaption"></p>

    </div>
</div>

<!-- DELETE CONFIRMATION MODAL -->
<div id="deleteConfirmModal"
     class="delete-confirm-modal"
     aria-hidden="true">

    <div class="delete-confirm-panel"
         role="dialog"
         aria-modal="true"
         aria-labelledby="deleteConfirmTitle">

        <div class="delete-confirm-header">
            <span>PORTFOLIO / CONFIRMATION</span>
            <span class="delete-warning-icon">!</span>
        </div>

        <div class="delete-confirm-body">

            <span class="delete-confirm-eyebrow">
                WARNING / DESTRUCTIVE ACTION
            </span>

            <h2 id="deleteConfirmTitle">
                Delete <span>Project?</span>
            </h2>

            <p id="deleteConfirmMessage">
                Are you sure you want to delete this project?
                This action cannot be undone.
            </p>

        </div>

        <div class="delete-confirm-actions">

            <button type="button"
                    id="cancelDeleteButton"
                    class="delete-cancel-button">
                Cancel
            </button>

            <button type="button"
                    id="confirmDeleteButton"
                    class="delete-confirm-button">
                Delete Project <span>→</span>
            </button>

        </div>

        <div class="delete-confirm-footer">
            PORTFOLIO SYSTEM / DELETE REQUEST
        </div>

    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // ELEMENT REFERENCES
            const projectOpenButtons = document.querySelectorAll("[data-project-open]");
            const projectOverlays = document.querySelectorAll(".project-overlay");

            const lightbox = document.getElementById("imageLightbox");
            const lightboxImage = document.getElementById("lightboxImage");
            const lightboxCaption = document.getElementById("lightboxCaption");
            const lightboxClose = document.getElementById("lightboxClose");
                    // Keep the lightbox above page and project overlay stacking contexts.
            document.body.appendChild(lightbox);

            const deleteModal = document.getElementById("deleteConfirmModal");
            document.body.appendChild(deleteModal);
            const deleteTitle = document.getElementById("deleteConfirmTitle");
            const deleteMessage = document.getElementById("deleteConfirmMessage");

            const cancelDeleteButton = document.getElementById("cancelDeleteButton");
            const confirmDeleteButton = document.getElementById("confirmDeleteButton");

            let activeProjectOverlay = null;
            let pendingDeleteForm = null;

            // CENTRALIZED SCROLL LOCK
            function updateScrollLock() {

                const deleteModalOpen =
                    deleteModal.classList.contains("active");

                const lightboxOpen =
                    lightbox.classList.contains("active");

                const projectOverlayOpen =
                    activeProjectOverlay !== null;

                const shouldLock =
                    deleteModalOpen || lightboxOpen || projectOverlayOpen;

                document.body.style.overflow = shouldLock ? "hidden" : "";
            }

            // FULL PROJECT OVERLAY

            // Return an overlay to the project grid it came from.
            function restoreOverlay(overlay) {

                if (!overlay.originalParent || overlay.parentElement !== document.body) return;

                overlay.originalParent.insertBefore(
                    overlay,
                    overlay.originalNextSibling
                );
            }

            function openProject(overlay) {
                if (!overlay) return;

                activeProjectOverlay = overlay;

                // Only record the original position if the overlay is still in the grid.
                // If it is reopened while still closing, it is already in <body>.
                if (overlay.parentElement !== document.body) {
                    overlay.originalParent = overlay.parentElement;
                    overlay.originalNextSibling = overlay.nextSibling;

                    document.body.appendChild(overlay);
                }

                // Let the browser apply the overlay's initial hidden state first.
                overlay.getBoundingClientRect();

                // Now activate it so the CSS transition can run.
                overlay.classList.add("active");
                overlay.setAttribute("aria-hidden", "false");

                document.body.classList.add("project-overlay-open");
                updateScrollLock();

                const closeButton = overlay.querySelector(".project-overlay-close");
                closeButton?.focus();
            }

            function closeProject() {

                if (!activeProjectOverlay) return;

                const overlay = activeProjectOverlay;

                overlay.classList.remove("active");
                overlay.setAttribute("aria-hidden", "true");

                activeProjectOverlay = null;

                document.body.classList.remove("project-overlay-open");

                updateScrollLock();

                // Normally the overlay is returned in the transitionend handler below,
                // after the fade-out finishes. With reduced motion there is no transition
                // (and so no transitionend event), so return it immediately.
                if (parseFloat(getComputedStyle(overlay).transitionDuration) === 0) {
                    restoreOverlay(overlay);
                }
            }

          

            projectOpenButtons.forEach(button => {

                button.addEventListener("click", function () {

                    const overlayId = this.dataset.projectOpen;
                    const overlay = document.getElementById(overlayId);

                    openProject(overlay);

                });

            });

            projectOverlays.forEach(overlay => {

                const closeButton =
                    overlay.querySelector(".project-overlay-close");

                closeButton?.addEventListener("click", closeProject);



                overlay.addEventListener("click", function (event) {

                    if (event.target === overlay) {
                        closeProject();
                    }

                });

                overlay.addEventListener("transitionend", function (event) {

                    // Ignore transitions of child elements and of properties other than opacity.
                    if (event.target !== overlay || event.propertyName !== "opacity") return;

                    // Opening also fires this event, and the overlay may have been reopened mid-close.
                    if (overlay.classList.contains("active")) return;

                    restoreOverlay(overlay);
                });

            });

            // IMAGE LIGHTBOX
            document.querySelectorAll(".project-thumbnail").forEach(image => {

                image.addEventListener("click", function () {

                    lightboxImage.src = this.dataset.fullImage;
                    lightboxCaption.textContent =
                        this.dataset.imageCaption || "";

                    lightbox.classList.add("active");

                    updateScrollLock();

                });

            });

            function closeLightbox() {

                lightbox.classList.remove("active");

                lightboxImage.src = "";
                lightboxCaption.textContent = "";

                updateScrollLock();
            }

            lightbox.addEventListener("click", function (event) {

                if (event.target === lightbox) {
                    closeLightbox();
                }

            });

            lightboxClose.addEventListener("click", closeLightbox);

            // DELETE CONFIRMATION MODAL
            document.querySelectorAll("[data-confirm-delete]").forEach(button => {

                button.addEventListener("click", function (event) {

                    event.preventDefault();

                    pendingDeleteForm = this.closest("form");

                    if (!pendingDeleteForm) return;

                    deleteTitle.textContent =
                        this.dataset.confirmTitle || "Delete Project?";

                    deleteMessage.textContent =
                        this.dataset.confirmMessage ||
                        "Are you sure you want to delete this project?";

                    const buttonText =
                        this.dataset.confirmButton || "Delete";

                    confirmDeleteButton.innerHTML =
                        `${buttonText} <span>→</span>`;

                    deleteModal.classList.add("active");
                    deleteModal.setAttribute("aria-hidden", "false");

                    updateScrollLock();

                    cancelDeleteButton.focus();

                });

            });

            function closeDeleteModal() {

                deleteModal.classList.remove("active");
                deleteModal.setAttribute("aria-hidden", "true");

                pendingDeleteForm = null;

                updateScrollLock();
            }

            cancelDeleteButton.addEventListener(
                "click",
                closeDeleteModal
            );

            deleteModal.addEventListener("click", function (event) {

                if (event.target === deleteModal) {
                    closeDeleteModal();
                }

            });

            confirmDeleteButton.addEventListener("click", function () {

                if (pendingDeleteForm) {
                    pendingDeleteForm.submit();
                }

            });

            // ESCAPE KEY
            document.addEventListener("keydown", function (event) {

                if (event.key !== "Escape") return;

                if (deleteModal.classList.contains("active")) {
                    closeDeleteModal();
                }
                else if (lightbox.classList.contains("active")) {
                    closeLightbox();
                }
                else if (activeProjectOverlay) {
                    closeProject();
                }

            });

            // SUCCESS MESSAGE AUTO-DISMISS
            // ========================================
            // COURSE ACCORDION
            // ========================================

            const courseSections = document.querySelectorAll(".course-section");

            const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

            // Animates the section's height (and its top padding) between two sizes.
            function animateCourseHeight(content, fromHeight, fromPadding, toHeight, toPadding, duration, onDone) {

                // Clip overflowing content only while the animation runs,
                // so card hover shadows are not clipped the rest of the time.
                content.style.overflow = "hidden";

                const animation = content.animate(
                    [
                        { height: fromHeight + "px", paddingTop: fromPadding + "px" },
                        { height: toHeight + "px", paddingTop: toPadding + "px" }
                    ],
                    { duration: duration, easing: "ease" }
                );

                content._heightAnimation = animation;

                animation.onfinish = function () {
                    content._heightAnimation = null;
                    content.style.overflow = "";

                    if (onDone) onDone();
                };
            }

            function setCourseOpen(section, isOpen, animate = false) {
                const toggle = section.querySelector(".course-toggle");
                const content = section.querySelector(".course-projects");

                toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");

                const instant = !animate || prefersReducedMotion.matches;

                // Stop any height animation in progress, remembering how tall the section is right now.
                let startHeight = null;
                let startPadding = null;

                if (content._heightAnimation) {
                    const current = getComputedStyle(content);
                    startHeight = parseFloat(current.height);
                    startPadding = parseFloat(current.paddingTop);

                    content._heightAnimation.onfinish = null;
                    content._heightAnimation.cancel();
                    content._heightAnimation = null;
                    content.style.overflow = "";
                }

                if (isOpen) {
                    const wasHidden = content.hidden;

                    content.classList.remove("closing");
                    content.hidden = false;

                    // Nothing to animate: instant mode, or it was already fully open.
                    if (instant || (!wasHidden && startHeight === null)) return;

                    const natural = getComputedStyle(content);

                    animateCourseHeight(
                        content,
                        startHeight ?? 0,
                        startPadding ?? 0,
                        parseFloat(natural.height),
                        parseFloat(natural.paddingTop),
                        300
                    );

                    return;
                }

                // Closing
                if (content.hidden) return;

                if (instant) {
                    content.classList.remove("closing");
                    content.hidden = true;
                    return;
                }

                const natural = getComputedStyle(content);

                content.classList.add("closing");

                animateCourseHeight(
                    content,
                    startHeight ?? parseFloat(natural.height),
                    startPadding ?? parseFloat(natural.paddingTop),
                    0,
                    0,
                    250,
                    function () {
                        content.classList.remove("closing");
                        content.hidden = true;
                    }
                );
            }

            

            courseSections.forEach(section => {
                const toggle = section.querySelector(".course-toggle");

                toggle.addEventListener("click", function () {
                    // Search results can have multiple expanded courses.
                    if (projectSearch.value.trim() !== "") {
                        const isOpen = toggle.getAttribute("aria-expanded") === "true";
                        setCourseOpen(section, !isOpen, true);
                        return;
                    }

                    const isCurrentlyOpen =
                        toggle.getAttribute("aria-expanded") === "true";

                    // Close every course first.
                    courseSections.forEach(otherSection => {
                        setCourseOpen(otherSection, false, true);
                    });

                    // Open the selected course if it was previously closed.
                    if (!isCurrentlyOpen) {
                        setCourseOpen(section, true, true);
                    }
                });
            });

            // ========================================
            // PROJECT SEARCH
            // ========================================

            const projectSearch = document.getElementById("projectSearch");
            const clearProjectSearch = document.getElementById("clearProjectSearch");
            const projectSearchStatus = document.getElementById("projectSearchStatus");
            const projectsCollection = document.querySelector(".projects-collection");

            let searchEmptyMessage = null;

            function searchProjects() {
                const query = projectSearch.value.trim().toLowerCase();
                const searching = query.length > 0;

                let totalMatches = 0;
                let matchingCourses = 0;

                clearProjectSearch.classList.toggle("visible", searching);

                courseSections.forEach(section => {
                    const courseText =
                        section.dataset.courseSearch.toLowerCase();

                    const courseMatches = courseText.includes(query);

                    const cards = section.querySelectorAll(".project-card");

                    let courseMatchesCount = 0;

                    cards.forEach(card => {
                        const projectText =
                            card.dataset.projectSearch.toLowerCase();

                        const projectMatches =
                            !searching ||
                            courseMatches ||
                            projectText.includes(query);

                        card.hidden = !projectMatches;

                        if (projectMatches) {
                            courseMatchesCount++;
                            totalMatches++;
                        }
                    });

                    const hasMatches = courseMatchesCount > 0;

                    section.hidden = !hasMatches;

                    if (hasMatches) {
                        matchingCourses++;

                        // Show matching results while searching.
                        if (searching) {
                            setCourseOpen(section, true);
                        }
                    } else {
                        setCourseOpen(section, false);
                    }
                });

                // Remove the no-results message when it is no longer needed.
                if (searchEmptyMessage) {
                    searchEmptyMessage.remove();
                    searchEmptyMessage = null;
                }

                if (searching) {
                    projectSearchStatus.textContent =
                        `${totalMatches} project(s) found in ${matchingCourses} course(s).`;

                    if (totalMatches === 0) {
                        projectSearchStatus.textContent = "No matching projects found.";

                        searchEmptyMessage = document.createElement("div");
                        searchEmptyMessage.className = "projects-search-empty";

                        searchEmptyMessage.innerHTML = `
                        <h3>No Projects Found</h3>
                        <p>Try another project title, description, or course name.</p>
                    `;

                        projectsCollection.appendChild(searchEmptyMessage);
                    }
                } else {
                    projectSearchStatus.textContent = "";

                    // Return to the default collapsed view.
                    courseSections.forEach(section => {
                        setCourseOpen(section, false);
                    });
                }
            }

            if (projectSearch) {
                projectSearch.addEventListener("input", searchProjects);

                clearProjectSearch.addEventListener("click", function () {
                    projectSearch.value = "";
                    searchProjects();
                    projectSearch.focus();
                });
            }

            document.querySelectorAll(".auto-dismiss").forEach(alert => {

                setTimeout(() => {

                    alert.classList.add("alert-hiding");

                    setTimeout(() => {
                        alert.remove();
                    }, 500);

                }, 3000);

            });

        });
    </script>
}
