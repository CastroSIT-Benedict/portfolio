@model List<portfolio.Models.Project>

@{
    ViewData["Title"] = "Projects";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-2">My Projects</h1>
        <p class="text-muted mb-0">
            A collection of projects from my courses.
        </p>
    </div>

    
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success fade show auto-dismiss">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    @if (User.IsInRole("Editor"))
    {
        <div class="d-flex gap-2">
            <a asp-controller="Courses"
               asp-action="Index"
               class="btn btn-outline-primary">
                Manage Courses
            </a>

            <a asp-controller="Projects"
               asp-action="Create"
               class="btn btn-primary">
                Add Project
            </a>
        </div>
    }
</div>

@if (Model.Count == 0)
{
    <p>No projects found.</p>
}
else
{
    @foreach (var course in Model.GroupBy(p => new { p.CourseCode, p.CourseName }))
    {
        <section class="mb-4">
            <h2>@course.Key.CourseCode</h2>
            <p class="text-muted">@course.Key.CourseName</p>

            <div class="row">
                @foreach (var project in course)
                {
                    <div class="col-md-6 mb-3">
                        <div class="card h-100">
                            <div class="card-body">

                                <h5 class="card-title">
                                    @project.Title
                                </h5>

                                <p class="card-text">
                                    @(project.Description ?? "No description available.")
                                </p>

                                <p class="text-muted">
                                    <small>
                                        Date: @(project.ProjectDate?.ToString("MMMM dd, yyyy") ?? "No date")
                                    </small>
                                </p>

                                @if (!string.IsNullOrEmpty(project.GithubUrl))
                                {
                                    <a href="@project.GithubUrl"
                                       target="_blank"
                                       rel="noopener noreferrer">
                                        View GitHub
                                    </a>
                                }

                                @if (!string.IsNullOrEmpty(project.VideoUrl))
                                {
                                    <a href="@project.VideoUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="ms-2">
                                        View Video
                                    </a>
                                }

                                @* Uploaded project images *@

                                @if (project.Images.Count > 0)
                                {
                                    <hr />

                                    <button class="btn btn-outline-secondary btn-sm"
                                            type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#images-@project.ProjectId"
                                            aria-expanded="false"
                                            aria-controls="images-@project.ProjectId">

                                        View Images (@project.Images.Count)
                                    </button>

                                    <div class="collapse mt-3"
                                         id="images-@project.ProjectId">

                                        <div class="row g-3">
                                            @foreach (var image in project.Images)
                                            {
                                                <div class="col-6 col-md-4">
                                                    <img src="@image.ImageUrl"
                                                         alt="@(image.Caption ?? project.Title)"
                                                         class="img-fluid rounded project-thumbnail"
                                                         loading="lazy"
                                                         data-full-image="@image.ImageUrl"
                                                         data-image-caption="@image.Caption" />

                                                    @if (!string.IsNullOrWhiteSpace(image.Caption))
                                                    {
                                                        <p class="text-muted small mt-1 mb-0">
                                                            @image.Caption
                                                        </p>
                                                    }

                                                    @if (User.IsInRole("Editor"))
                                                    {
                                                        <form asp-controller="Projects"
                                                              asp-action="DeleteImage"
                                                              method="post"
                                                              onsubmit="return confirm('Are you sure you want to delete this image?');"
                                                              class="mt-2">

                                                            <input type="hidden"
                                                                   name="imageId"
                                                                   value="@image.ImageId" />

                                                            <button type="submit"
                                                                    class="btn btn-sm btn-outline-danger">
                                                                Delete Image
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                @if (User.IsInRole("Editor"))
                                {
                                    <hr />

                                    <div class="d-flex gap-2 flex-wrap">
                                        <a asp-controller="Projects"
                                           asp-action="Edit"
                                           asp-route-id="@project.ProjectId"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>

                                        <a asp-controller="Projects"
                                           asp-action="UploadImage"
                                           asp-route-projectId="@project.ProjectId"
                                           class="btn btn-sm btn-outline-success">
                                            Upload Image
                                        </a>

                                        <form asp-controller="Projects"
                                              asp-action="Delete"
                                              asp-route-id="@project.ProjectId"
                                              method="post"
                                              onsubmit="return confirm('Are you sure you want to delete this project?');">

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                }

                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    }
}

@* Enlarged image overlay *@

<div id="imageLightbox" class="image-lightbox">
    <div class="lightbox-content">
        <img id="lightboxImage" src="" alt="Expanded project image" />
        <p id="lightboxCaption"></p>
    </div>
</div>

<style>
    .project-thumbnail {
        width: 100%;
        height: 150px;
        object-fit: cover;
        cursor: pointer;
        transition: transform 0.2s ease;
    }

        .project-thumbnail:hover {
            transform: scale(1.03);
        }

    .image-lightbox {
        display: none;
        position: fixed;
        z-index: 2000;
        inset: 0;
        background: rgba(0, 0, 0, 0.85);
        justify-content: center;
        align-items: center;
        padding: 20px;
        cursor: pointer;
    }

        .image-lightbox.active {
            display: flex;
        }

    .lightbox-content {
        max-width: 90%;
        max-height: 90%;
        text-align: center;
        cursor: default;
    }

        .lightbox-content img {
            max-width: 100%;
            max-height: 80vh;
            object-fit: contain;
            border-radius: 8px;
        }

        .lightbox-content p {
            color: white;
            margin-top: 12px;
        }
</style>

<script>
    const lightbox = document.getElementById("imageLightbox");
    const lightboxImage = document.getElementById("lightboxImage");
    const lightboxCaption = document.getElementById("lightboxCaption");

    // Open the enlarged image.
    document.querySelectorAll(".project-thumbnail").forEach(image => {
        image.addEventListener("click", function () {
            lightboxImage.src = this.dataset.fullImage;
            lightboxCaption.textContent = this.dataset.imageCaption || "";

            lightbox.classList.add("active");
            document.body.style.overflow = "hidden";
        });
    });

    // Close when clicking outside the image.
    lightbox.addEventListener("click", function (event) {
        if (event.target === lightbox) {
            closeLightbox();
        }
    });

    // Close when pressing Escape.
    document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") {
            closeLightbox();
        }
    });

    function closeLightbox() {
        lightbox.classList.remove("active");
        lightboxImage.src = "";
        lightboxCaption.textContent = "";
        document.body.style.overflow = "";
    }
</script>

<script>
    document.querySelectorAll(".auto-dismiss").forEach(alert => {
        setTimeout(() => {
            alert.classList.remove("show");

            setTimeout(() => {
                alert.remove();
            }, 500);

        }, 3000);
    });
</script>
