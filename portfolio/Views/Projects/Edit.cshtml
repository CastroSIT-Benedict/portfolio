
@model portfolio.Models.Project

@{
    ViewData["Title"] = "Edit Project";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/project-forms.css"
          asp-append-version="true" />
}

<div class="editor-page">
    <section class="editor-panel">

        <header class="editor-heading">
            <div>
                <span class="editor-eyebrow">EDITOR / PROJECTS</span>
                <h1>Edit Project</h1>
                <p>Update the details of your project.</p>
            </div>

            <span class="editor-panel-mark">EDIT ENTRY</span>
        </header>

        <form asp-controller="Projects"
              asp-action="Edit"
              asp-route-id="@Model.ProjectId"
              method="post"
              class="editor-form">

            <input type="hidden" asp-for="ProjectId" />

            <div asp-validation-summary="ModelOnly"
                 class="editor-validation-summary">
            </div>

            <div class="editor-field">
                <label asp-for="CourseId">Course</label>

                <select asp-for="CourseId"
                        class="form-select"
                        asp-items="@(new SelectList(ViewBag.Courses, "CourseId", "CourseCode"))">
                    <option value="">Select a course</option>
                </select>

                <span asp-validation-for="CourseId"
                      class="editor-validation">
                </span>
            </div>

            <div class="editor-field">
                <label asp-for="Title">Project Title</label>

                <input asp-for="Title"
                       class="form-control" />

                <span asp-validation-for="Title"
                      class="editor-validation">
                </span>
            </div>

            <div class="editor-field full-width">
                <label asp-for="Description">Description</label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="3">
                </textarea>

                <span asp-validation-for="Description"
                      class="editor-validation">
                </span>
            </div>

            <div class="editor-field">
                <label asp-for="GithubUrl">GitHub URL</label>

                <input asp-for="GithubUrl"
                       class="form-control" />

                <span asp-validation-for="GithubUrl"
                      class="editor-validation">
                </span>
            </div>

            <div class="editor-field">
                <label asp-for="VideoUrl">Video URL</label>

                <input asp-for="VideoUrl"
                       class="form-control" />

                <span asp-validation-for="VideoUrl"
                      class="editor-validation">
                </span>
            </div>

            <div class="editor-field">
                <label asp-for="ProjectDate">Project Date</label>

                <input asp-for="ProjectDate"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="ProjectDate"
                      class="editor-validation">
                </span>
            </div>

            <div class="editor-form-actions">
                <a asp-controller="Projects"
                   asp-action="Index"
                   class="editor-cancel-button">
                    Cancel
                </a>

                <button type="submit" class="editor-save-button">
                    Save Changes
                </button>
            </div>

        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
