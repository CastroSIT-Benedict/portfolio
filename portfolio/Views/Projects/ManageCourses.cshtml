
@model List<portfolio.Models.Course>

@{
    ViewData["Title"] = "Manage Courses";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Manage Courses</h1>
        <p class="text-muted mb-0">
            Add, edit, or remove the courses associated with your projects.
        </p>
    </div>

    @if (User.IsInRole("Editor"))
    {
        <a asp-controller="Courses"
           asp-action="Create"
           class="btn btn-primary">
            Add Course
        </a>
    }
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (Model.Count == 0)
{
    <p>No courses found.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Course Code</th>
                    <th>Course Name</th>
                    @if (User.IsInRole("Editor"))
                    {
                        <th class="text-end">Actions</th>
                    }
                </tr>
            </thead>

            <tbody>
                @foreach (var course in Model)
                {
                    <tr>
                        <td>@course.CourseCode</td>
                        <td>@course.CourseName</td>

                        @if (User.IsInRole("Editor"))
                        {
                            <td class="text-end">
                                <a asp-controller="Courses"
                                   asp-action="Edit"
                                   asp-route-id="@course.CourseId"
                                   class="btn btn-sm btn-outline-secondary">
                                    Edit
                                </a>

                                <form asp-controller="Courses"
                                      asp-action="Delete"
                                      asp-route-id="@course.CourseId"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete this course?');">

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a asp-controller="Projects"
   asp-action="Index"
   class="btn btn-outline-secondary mt-3">
    Back to Projects
</a>
